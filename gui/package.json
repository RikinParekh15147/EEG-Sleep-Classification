{
  "name": "eeg-sleep-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Windows desktop workspace for the Fast SCFormer-U EEG sleep staging pipeline",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node scripts/start.cjs",
    "dev": "node scripts/dev.cjs",
    "preview": "node scripts/preview.cjs",
    "build": "node scripts/build.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:python": "python3 -m unittest discover -s tests -p \"test_*.py\"",
    "test:ui": "playwright test",
    "check": "npm run build && npm test",
    "postinstall": "node scripts/postinstall.cjs",
    "test:desktop": "node scripts/smoke-desktop.cjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^43.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.64.1",
    "@rollup/rollup-linux-x64-gnu": "4.64.1"
  }
}
