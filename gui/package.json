{
  "name": "eeg-sleep-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Windows desktop workspace for the Fast SCFormer-U EEG sleep staging pipeline",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node scripts/start.cjs",
    "dev": "node scripts/dev.cjs",
    "preview": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.cjs",
    "test:python": "python3 -m unittest discover -s tests -p \"test_*.py\"",
    "test:ui": "playwright test",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "vite": "^7.3.0",
    "typescript": "^5.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@playwright/test": "^1.58.0"
  }
}
